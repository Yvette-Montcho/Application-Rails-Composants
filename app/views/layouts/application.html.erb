<%# app/views/layouts/application.html.erb — Fichier de layout principal de l'application %>
<%# Toutes les pages de l'application sont enveloppées dans ce template %>
<%# Le contenu spécifique à chaque page est injecté via <%= yield %> %>

<!DOCTYPE html>
<%# Déclaration HTML5 avec la langue définie en français %>
<html lang="fr">
  <head>
    <%# ── MÉTADONNÉES DE BASE ─────────────────────────────────────────── %>

    <%# Encodage UTF-8 pour supporter les caractères accentués et spéciaux %>
    <meta charset="UTF-8">

    <%# Viewport responsive : adapte l'affichage à toutes les tailles d'écran %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%# Compatibilité Internet Explorer (bonne pratique) %>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <%# Titre dynamique : appelle le helper page_title défini dans application_helper.rb %>
    <%# content_for(:title) permet aux views individuelles de définir leur propre titre %>
    <title><%= page_title(content_for?(:title) ? yield(:title) : nil) %></title>

    <%# ── CDN BOOTSWATCH (THÈME LUX) ─────────────────────────────────── %>

    <%# Bootswatch est une collection de thèmes Bootstrap gratuits %>
    <%# Le thème "Lux" donne un rendu élégant et professionnel %>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/lux/bootstrap.min.css">

    <%# ── ICÔNES BOOTSTRAP ────────────────────────────────────────────── %>

    <%# Bootstrap Icons : bibliothèque d'icônes SVG officielle Bootstrap %>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%# ── STYLES PERSONNALISÉS ────────────────────────────────────────── %>

    <%# Charge le fichier app/assets/stylesheets/application.css %>
    <%# (ou le pipeline Sprockets si configuré) %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# Charge les scripts JavaScript via Importmap %>
    <%= javascript_importmap_tags %>

    <%# Bloc optionnel : permet aux views individuelles d'injecter des styles supplémentaires %>
    <%= yield :head %>
  </head>

  <body>
    <%# ── HEADER ─────────────────────────────────────────────────────── %>

    <%# Appelle la partial app/views/layouts/_header.html.erb %>
    <%# Contient la barre de navigation commune à toutes les pages %>
    <%# Note : pour les partials dans layouts/, on doit préciser le chemin complet %>
    <%= render 'layouts/header' %>

    <%# ── ALERTES FLASH ──────────────────────────────────────────────── %>

    <%# Appelle la partial app/views/layouts/_flash.html.erb %>
    <%# Affiche les messages flash (succès, erreur, info) entre le header et le contenu %>
    <%= render 'layouts/flash' %>

    <%# ── CONTENU PRINCIPAL ──────────────────────────────────────────── %>

    <%# yield injecte ici le contenu HTML de chaque view individuelle %>
    <%# C'est le "trou" dans le layout que chaque page vient remplir %>
    <main>
      <%= yield %>
    </main>

    <%# ── FOOTER ─────────────────────────────────────────────────────── %>

    <%# Appelle la partial app/views/layouts/_footer.html.erb %>
    <%# Contient les informations de bas de page communes à toutes les pages %>
    <%= render 'layouts/footer' %>

    <%# ── SCRIPTS BOOTSTRAP (JS) ─────────────────────────────────────── %>

    <%# Bundle Bootstrap JS avec Popper.js intégré (nécessaire pour les modals, dropdowns, etc.) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
