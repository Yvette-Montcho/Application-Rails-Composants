<%# app/views/events/_event.html.erb — Partial de carte d'événement %>
<%# Affiche un événement sous forme de carte Bootstrap (card) %>
<%# Peut être appelée avec une variable locale "event" ou la convention Rails %>
<%#
<%# Appelée depuis index.html.erb via :
<%#   <%= render @events %>                    (Rails itère automatiquement)
<%#   <%= render partial: 'event', collection: @events %> (forme explicite)
<%#   <%= render partial: 'event', locals: { event: @event } %> (un seul)

<%# Carte Bootstrap avec ombre légère au survol (transition CSS) %>
<div class="card h-100 shadow-sm border-0 event-card">

  <%# ── IMAGE DE COUVERTURE ─────────────────────────────────────────── %>

  <%# Lien cliquable sur l'image qui mène vers la page de détail de l'événement %>
  <%= link_to event_path(event) do %>
    <%# display_image est défini dans le modèle Event — retourne un placeholder si pas d'image %>
    <img src="<%= event.display_image %>"
         class="card-img-top"
         alt="Image de <%= event.title %>"
         style="height: 180px; object-fit: cover;">
  <% end %>

  <%# ── CORPS DE LA CARTE ───────────────────────────────────────────── %>
  <div class="card-body d-flex flex-column">

    <%# Badge de catégorie de prix — "Gratuit" en vert, "Payant" en bleu %>
    <span class="badge <%= event.price.zero? ? 'bg-success' : 'bg-primary' %> mb-2 align-self-start">
      <%= event.formatted_price %>  <%# Méthode définie dans le modèle Event %>
    </span>

    <%# Titre de l'événement avec lien vers la page de détail %>
    <h5 class="card-title">
      <%= link_to event.title, event_path(event), class: "text-dark text-decoration-none" %>
    </h5>

    <%# Description tronquée à 100 caractères pour éviter des cartes trop longues %>
    <p class="card-text text-muted small flex-grow-1">
      <%= truncate(event.description, length: 100) %>
    </p>

    <%# ── MÉTADONNÉES DE L'ÉVÉNEMENT ──────────────────────────────── %>
    <div class="mt-auto">

      <%# Lieu de l'événement avec icône de localisation %>
      <p class="card-text small mb-1">
        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
        <%= event.location %>
      </p>

      <%# Date de l'événement formatée en français (ex: "15 mai 2025 à 20h00") %>
      <p class="card-text small mb-3">
        <i class="bi bi-calendar3 text-primary me-1"></i>
        <%# strftime formate la date Ruby en chaîne lisible %>
        <%= event.event_date.strftime("%d %B %Y à %Hh%M") %>
      </p>

      <%# Bouton "Voir l'événement" — lien vers la page de détail %>
      <%= link_to "Voir l'événement", event_path(event), class: "btn btn-outline-primary btn-sm w-100" %>
    </div>

  </div>
</div>
